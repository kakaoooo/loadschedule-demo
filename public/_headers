# Netlify / Cloudflare Pages — ส่วนหัวความปลอดภัยของเวอร์ชันสาธิต (GitHub Pages ไม่รองรับไฟล์นี้: ใช้ <meta> CSP ใน index.html)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
